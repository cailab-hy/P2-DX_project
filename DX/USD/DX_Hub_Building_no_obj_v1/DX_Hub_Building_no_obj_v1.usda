        string frame = "Z-up, metres, floor z=0, walls along X/Y (same frame as DX_Hub / DX_Hub_Building v2)"
    }
    defaultPrim = "DX_Hub_Building"
    doc = "DX Hub 11F (CARE robot vocational training centre) - empty building no_obj_v1: floor, walls, ceiling, windows, doors, glass partitions, built-in counters. Measured from the 2026-06-22 LiDAR scan."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DX_Hub_Building" (
    assetInfo = {
        string name = "DX_Hub_Building"
        string version = "3.0"
    }
    kind = "assembly"
    prepend payload = @./payloads/building.usdc@
    variants = {
        string blinds = "down"
        string doors = "closed"
        string fixtures = "counters"
        string lighting = "day"
    }
    prepend variantSets = ["doors", "blinds", "fixtures", "lighting"]
)
{
    over "Lights"
    {
        def Xform "Daylight"
        {
            def Xform "Overcast"
            {
                def DomeLight "Sky"
                {
                    float inputs:intensity = 1000
                    asset inputs:texture:file = @./textures/kloofendal_overcast_puresky_2k.hdr@
                    token inputs:texture:format = "latlong"
                }
            }

            def Xform "Sunny"
            {
                def DomeLight "Sky"
                {
                    float inputs:intensity = 1000
                    asset inputs:texture:file = @./textures/kloofendal_48d_partly_cloudy_puresky_2k.hdr@
                    token inputs:texture:format = "latlong"
                }

                def DistantLight "Sun"
                {
                    float inputs:angle = 0.53
                    float inputs:colorTemperature = 5800
                    bool inputs:enableColorTemperature = 1
                    float inputs:intensity = 3000
                    float3 xformOp:rotateXYZ = (55, 0, 250)
                    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
                }
            }
        }
    }
